{
  "name": "dsh-requirements-alignment",
  "description": "Runtime requirement drift guard for DeepSeek Harness — keeps long-running agents aligned with user intent while they work.",
  "version": "0.2.0",
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "cordis",
    "requirement-alignment",
    "agent",
    "ai-agent"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jiezeng2004-design/dsh-requirements-alignment.git"
  },
  "homepage": "https://github.com/jiezeng2004-design/dsh-requirements-alignment#readme",
  "bugs": {
    "url": "https://github.com/jiezeng2004-design/dsh-requirements-alignment/issues"
  },
  "packageManager": "pnpm@11.19.0",
  "type": "module",
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "exports": {
    ".": {
      "types": "./lib/index.d.ts",
      "default": "./lib/index.js"
    },
    "./types": {
      "types": "./lib/types.d.ts",
      "default": "./lib/types.js"
    },
    "./policy": {
      "types": "./lib/policy.d.ts",
      "default": "./lib/policy.js"
    },
    "./align-driver": {
      "types": "./lib/align-driver.d.ts",
      "default": "./lib/align-driver.js"
    },
    "./scripted-provider": {
      "types": "./lib/scripted-provider.d.ts",
      "default": "./lib/scripted-provider.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.check.json",
    "lint": "eslint src test",
    "test": "node --test --experimental-test-isolation=none test/*.test.ts",
    "check": "pnpm run typecheck && pnpm run lint && pnpm run build && pnpm test"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-commands": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-llm": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-session": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-system-prompt": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tool-ask-user": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-tools": "^0.1.0-rc.6",
    "@deepseek-ai/dsh-user-questions": "^0.1.0-rc.6",
    "@deepseek-ai/schemastery": "3.18.1"
  },
  "peerDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/dsh-agent": {
      "optional": true
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-agent": "^0.1.0-rc.6",
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.0.0",
    "eslint": "^9.30.0",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.35.0"
  }
}
